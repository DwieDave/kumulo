{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./packages/oxlint/src/oxlint/index.ts"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "kumulo/no-banned-type-assertions": "error",
    "kumulo/no-comments": "error",
    "kumulo/no-multiple-function-params": "error",
    "kumulo/no-switch": "error",
    "kumulo/no-sync-schema-apis": "error",
    "kumulo/no-type-assertion": "error",
    "kumulo/no-yieldless-effect-gen": "error",
    "kumulo/private-function-prefix": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "eslint/no-underscore-dangle": "off",
    "eslint/no-eval": "error",
    "import/no-cycle": "error",
    "promise/no-return-wrap": "error",
    "unicorn/no-await-in-promise-methods": "error"
  },
  "overrides": [
    {
      "files": ["packages/oxlint/**"],
      "rules": { "kumulo/no-type-assertion": "off" }
    },
    {
      "files": ["scripts/**"],
      "rules": { "unicorn/no-thenable": "off" }
    },
    {
      "files": ["**/test/**"],
      "rules": { "kumulo/no-comments": "off" }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".references",
    "coverage",
    "packages/*/src/generated/**"
  ]
}
