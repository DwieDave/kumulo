{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kumulo cluster config",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "outputs": {
          "$ref": "#/$defs/Objects_"
        },
        "auth": {
          "$ref": "#/$defs/Objects_1"
        },
        "worker_pools": {
          "$ref": "#/$defs/Arrays_"
        },
        "volumes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Objects_2"
            },
            {
              "$ref": "#/$defs/Objects_3"
            },
            {
              "type": "object",
              "properties": {
                "module": {
                  "type": "string",
                  "enum": [
                    "hcloud"
                  ]
                },
                "managed": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Objects_4"
                  }
                }
              },
              "required": [
                "module",
                "managed"
              ],
              "additionalProperties": false
            }
          ]
        },
        "object_storage": {
          "$ref": "#/$defs/Union_"
        },
        "secrets": {
          "$ref": "#/$defs/Union_1"
        },
        "provider": {
          "type": "string",
          "enum": [
            "ovh",
            "generic",
            "hetzner"
          ]
        },
        "distro": {
          "type": "string",
          "enum": [
            "k3s"
          ]
        },
        "version": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^v\\d+\\.\\d+\\.\\d+\\+k3s\\d+$"
            }
          ]
        },
        "dns": {
          "$ref": "#/$defs/Union_2"
        },
        "network": {
          "type": "object",
          "properties": {
            "cidr": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\/(3[0-2]|[12]?\\d)$"
                }
              ]
            },
            "public_access": {
              "type": "string",
              "enum": [
                "bastionless",
                "nat"
              ]
            }
          },
          "required": [
            "cidr",
            "public_access"
          ],
          "additionalProperties": false
        },
        "api_server": {
          "type": "object",
          "properties": {
            "high_availability": {
              "type": "boolean"
            },
            "allowed_cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\/(3[0-2]|[12]?\\d)$"
                  }
                ]
              }
            }
          },
          "required": [
            "high_availability",
            "allowed_cidrs"
          ],
          "additionalProperties": false
        },
        "ssh": {
          "type": "object",
          "properties": {
            "public_key_path": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "allowed_cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "allOf": [
                  {
                    "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\/(3[0-2]|[12]?\\d)$"
                  }
                ]
              }
            }
          },
          "required": [
            "public_key_path",
            "allowed_cidrs"
          ],
          "additionalProperties": false
        },
        "masters": {
          "type": "object",
          "properties": {
            "flavor": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "count": {
              "type": "integer"
            },
            "image": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            }
          },
          "required": [
            "flavor",
            "count",
            "image"
          ],
          "additionalProperties": false
        },
        "addons": {
          "type": "object",
          "properties": {
            "cloud_controller_manager": {
              "type": "boolean"
            },
            "cinder_csi": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "default_volume_type": {
                  "type": "string",
                  "allOf": [
                    {
                      "minLength": 1
                    }
                  ]
                }
              },
              "required": [
                "enabled",
                "default_volume_type"
              ],
              "additionalProperties": false
            },
            "hcloud_csi": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "required": [
                "enabled"
              ],
              "additionalProperties": false
            },
            "system_upgrade_controller": {
              "type": "boolean"
            },
            "cni": {
              "type": "string",
              "enum": [
                "flannel",
                "cilium"
              ]
            }
          },
          "required": [
            "cloud_controller_manager",
            "cinder_csi",
            "hcloud_csi",
            "system_upgrade_controller",
            "cni"
          ],
          "additionalProperties": false
        },
        "k3s": {
          "type": "object",
          "properties": {
            "extra_server_args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "extra_agent_args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "extra_server_args",
            "extra_agent_args"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "auth",
        "worker_pools",
        "volumes",
        "object_storage",
        "secrets",
        "provider",
        "distro",
        "version",
        "dns",
        "network",
        "api_server",
        "ssh",
        "masters",
        "addons",
        "k3s"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "outputs": {
          "$ref": "#/$defs/Objects_"
        },
        "auth": {
          "$ref": "#/$defs/Objects_1"
        },
        "worker_pools": {
          "$ref": "#/$defs/Arrays_"
        },
        "volumes": {
          "anyOf": [
            {
              "$ref": "#/$defs/Objects_2"
            },
            {
              "$ref": "#/$defs/Objects_3"
            }
          ]
        },
        "object_storage": {
          "$ref": "#/$defs/Union_"
        },
        "secrets": {
          "$ref": "#/$defs/Union_1"
        },
        "provider": {
          "type": "string",
          "enum": [
            "ovh"
          ]
        },
        "distro": {
          "type": "string",
          "enum": [
            "ovh-mks"
          ]
        },
        "version": {
          "type": "string",
          "allOf": [
            {
              "pattern": "^v?\\d+\\.\\d+\\.\\d+$"
            }
          ]
        },
        "dns": {
          "$ref": "#/$defs/Union_2"
        },
        "network": {
          "type": "object",
          "properties": {
            "cidr": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\/(3[0-2]|[12]?\\d)$"
                }
              ]
            },
            "nodes_subnet": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\/(3[0-2]|[12]?\\d)$"
                }
              ]
            },
            "load_balancers_subnet": {
              "type": "string",
              "allOf": [
                {
                  "pattern": "^(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\/(3[0-2]|[12]?\\d)$"
                }
              ]
            },
            "gateway_model": {
              "type": "string",
              "enum": [
                "s",
                "m",
                "l",
                "xl",
                "2xl",
                "3xl"
              ]
            }
          },
          "required": [
            "cidr",
            "nodes_subnet",
            "load_balancers_subnet"
          ],
          "additionalProperties": false
        },
        "ingress": {
          "type": "object",
          "properties": {
            "flavor_id": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "flavor": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "auth",
        "worker_pools",
        "volumes",
        "object_storage",
        "secrets",
        "provider",
        "distro",
        "version",
        "dns"
      ],
      "additionalProperties": false
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "hetzner"
          }
        },
        "required": [
          "provider"
        ]
      },
      "then": {
        "properties": {
          "auth": {
            "properties": {
              "method": {
                "const": "api_token"
              }
            }
          },
          "volumes": {
            "properties": {
              "module": {
                "enum": [
                  "hcloud",
                  "none"
                ]
              }
            }
          },
          "addons": {
            "properties": {
              "cinder_csi": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "auth": {
            "properties": {
              "method": {
                "not": {
                  "const": "api_token"
                }
              }
            }
          },
          "volumes": {
            "properties": {
              "module": {
                "not": {
                  "const": "hcloud"
                }
              }
            }
          },
          "addons": {
            "properties": {
              "hcloud_csi": {
                "properties": {
                  "enabled": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "object_storage": {
            "properties": {
              "module": {
                "const": "ovh"
              }
            },
            "required": [
              "module"
            ]
          }
        },
        "required": [
          "object_storage"
        ]
      },
      "then": {
        "properties": {
          "secrets": {
            "properties": {
              "sink": {
                "not": {
                  "const": "none"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "ingress"
        ]
      },
      "then": {
        "required": [
          "network"
        ]
      }
    }
  ],
  "$defs": {
    "Objects_": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "yaml",
            "json"
          ]
        }
      },
      "required": [
        "format"
      ],
      "additionalProperties": false
    },
    "Objects_1": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "application_credential",
            "clouds_yaml",
            "env",
            "api_token"
          ]
        },
        "region": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        }
      },
      "required": [
        "method",
        "region"
      ],
      "additionalProperties": false
    },
    "Arrays_": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          },
          "flavor": {
            "type": "string",
            "allOf": [
              {
                "minLength": 1
              }
            ]
          },
          "count": {
            "type": "integer",
            "allOf": [
              {
                "minimum": 0
              }
            ]
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "taints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "autoscaling": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "min": {
                "type": "integer",
                "allOf": [
                  {
                    "minimum": 0
                  }
                ]
              },
              "max": {
                "type": "integer",
                "allOf": [
                  {
                    "exclusiveMinimum": 0
                  }
                ]
              }
            },
            "required": [
              "enabled",
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name",
          "flavor",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "Objects_2": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "enum": [
            "none"
          ]
        }
      },
      "required": [
        "module"
      ],
      "additionalProperties": false
    },
    "Objects_4": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "size_gb": {
          "type": "integer",
          "allOf": [
            {
              "exclusiveMinimum": 0
            }
          ]
        },
        "type": {
          "type": "string",
          "allOf": [
            {
              "minLength": 1
            }
          ]
        },
        "retain": {
          "type": "boolean"
        },
        "pvc": {
          "type": "object",
          "properties": {
            "namespace": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "access_modes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany",
                  "ReadOnlyMany"
                ]
              }
            }
          },
          "required": [
            "namespace",
            "access_modes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "size_gb",
        "type",
        "retain"
      ],
      "additionalProperties": false
    },
    "Objects_3": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "enum": [
            "cinder"
          ]
        },
        "managed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Objects_4"
          }
        }
      },
      "required": [
        "module",
        "managed"
      ],
      "additionalProperties": false
    },
    "Union_": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          "required": [
            "module"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "enum": [
                "ovh"
              ]
            },
            "buckets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "allOf": [
                      {
                        "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
                      }
                    ]
                  },
                  "region": {
                    "type": "string",
                    "allOf": [
                      {
                        "minLength": 1
                      }
                    ]
                  },
                  "versioning": {
                    "type": "boolean"
                  },
                  "encryption": {
                    "type": "boolean"
                  },
                  "retain": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "region",
                  "versioning",
                  "encryption",
                  "retain"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "module",
            "buckets"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Union_1": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "sink": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          "required": [
            "sink"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "sink": {
              "type": "string",
              "enum": [
                "sops"
              ]
            },
            "dir": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "sops": {
              "type": "object",
              "properties": {
                "age_recipient": {
                  "type": "string",
                  "allOf": [
                    {
                      "pattern": "^age1"
                    }
                  ]
                }
              },
              "required": [
                "age_recipient"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "sink",
            "dir",
            "sops"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Union_2": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          "required": [
            "module"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "enum": [
                "ovh",
                "hetzner"
              ]
            },
            "zone": {
              "type": "string",
              "allOf": [
                {
                  "minLength": 1
                }
              ]
            },
            "ttl": {
              "type": "integer",
              "allOf": [
                {
                  "exclusiveMinimum": 0
                }
              ]
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "allOf": [
                      {
                        "minLength": 1
                      }
                    ]
                  },
                  "target": {
                    "type": "string",
                    "allOf": [
                      {
                        "minLength": 1
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "target"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "module",
            "zone",
            "ttl",
            "records"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
