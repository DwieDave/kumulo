{
  "name": "kumulo",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": ["packages/*", "tools/*"],
    "catalog": {
      "effect": "4.0.0-beta.101",
      "@effect/platform-bun": "4.0.0-beta.101",
      "@effect/openapi-generator": "4.0.0-beta.101",
      "@effect/vitest": "4.0.0-beta.101",
      "vitest": "4.1.10",
      "fast-check": "4.9.0",
      "@types/bun": "1.3.14",
      "typescript": "7.0.2",
      "@effect/tsgo": "0.24.3"
    }
  },
  "scripts": {
    "typecheck": "for d in packages/* tools/*; do (cd \"$d\" && echo \"[typecheck] $d\" && ../../node_modules/.bin/tsc --noEmit) || exit 1; done",
    "test": "vitest run",
    "ci": "bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
