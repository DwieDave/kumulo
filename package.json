{
  "name": "kumulo",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "effect": "4.0.0-beta.101",
      "@effect/platform-bun": "4.0.0-beta.101",
      "@effect/openapi-generator": "4.0.0-beta.101",
      "@effect/vitest": "4.0.0-beta.101",
      "vitest": "4.1.10",
      "fast-check": "4.9.0",
      "@types/bun": "1.3.14",
      "typescript": "7.0.2",
      "@effect/tsgo": "0.24.3",
      "dependency-cruiser": "18.1.0",
      "@swc/core": "1.15.46",
      "oxlint": "1.75.0",
      "yaml": "2.9.0"
    }
  },
  "scripts": {
    "typecheck": "for d in packages/* tools/*; do (cd \"$d\" && echo \"[typecheck] $d\" && ../../node_modules/.bin/tsc --noEmit) || exit 1; done",
    "test": "vitest run",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages tools",
    "codegen:check": "cd tools/codegen && bun run check",
    "ci": "bun run typecheck && bun run test && bun run lint:deps && bun run lint && bun run codegen:check",
    "lint": "oxlint",
    "specs:update:ovh": "bash tools/ovh2openapi/scripts/update-specs.sh",
    "specs:update:openstack": "bash packages/openstack/scripts/update-specs.sh"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "dependency-cruiser": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
