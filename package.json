{
  "name": "kumulo",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "David Stahl-Gruber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwieDave/kumulo.git"
  },
  "homepage": "https://github.com/DwieDave/kumulo#readme",
  "bugs": "https://github.com/DwieDave/kumulo/issues",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/bunny/*",
      "packages/ovh/*",
      "packages/upcloud/*",
      "packages/hetzner/*",
      "packages/openstack/*",
      "tools/*"
    ],
    "catalog": {
      "effect": "4.1.0",
      "@effect/platform-bun": "4.1.0",
      "@effect/platform-node": "4.1.0",
      "@effect/openapi-generator": "4.1.0",
      "@effect/vitest": "4.1.0",
      "vitest": "5.0.5",
      "@types/bun": "1.4.4",
      "typescript": "7.0.2",
      "@effect/tsgo": "0.63.0",
      "dependency-cruiser": "18.7.0",
      "@swc/core": "1.16.20",
      "oxlint": "1.90.0",
      "@oxlint/plugins": "1.90.0",
      "yaml": "2.9.1",
      "ssh2": "1.17.0",
      "@types/ssh2": "1.15.6"
    }
  },
  "scripts": {
    "typecheck": "node scripts/typecheck-all.mjs",
    "test": "vitest run",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages tools",
    "codegen:check": "cd tools/codegen && bun run check",
    "ci": "bun run typecheck && bun run build && bun run test && bun run lint:deps && bun run lint && bun run codegen:check && bun run schema:check",
    "lint": "oxlint",
    "build": "node scripts/build-all.mjs",
    "schema:generate": "bun scripts/generate-schema.ts",
    "schema:check": "set -e; cp kumulo.schema.json .kumulo.schema.check.bak; bun scripts/generate-schema.ts; s=0; diff -u .kumulo.schema.check.bak kumulo.schema.json || { s=$?; echo 'kumulo.schema.json is stale: run `bun run schema:generate` and commit'; }; mv .kumulo.schema.check.bak kumulo.schema.json; exit $s",
    "version:bump": "node scripts/bump-version.mjs",
    "release:rewrite-deps": "node scripts/rewrite-workspace-deps.cjs",
    "specs:update:ovh": "bash tools/ovh2openapi/scripts/update-specs.sh",
    "specs:update:openstack": "bash packages/openstack/client/scripts/update-specs.sh",
    "specs:update:hetzner": "bash packages/hetzner/client/scripts/update-specs.sh"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/tsgo": "catalog:",
    "@kumulo/core": "workspace:*",
    "@kumulo/storage-ovh": "workspace:*",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "dependency-cruiser": "catalog:",
    "effect": "catalog:",
    "@oxlint/plugins": "catalog:",
    "oxlint": "catalog:",
    "tsdown": "^0.23.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
