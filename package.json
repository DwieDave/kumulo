{
  "name": "kumulo",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "David Stahl-Gruber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwieDave/kumulo.git"
  },
  "homepage": "https://github.com/DwieDave/kumulo#readme",
  "bugs": "https://github.com/DwieDave/kumulo/issues",
  "packageManager": "bun@1.3.13",
  "workspaces": {
    "packages": [
      "packages/*",
      "tools/*"
    ],
    "catalog": {
      "effect": "4.0.0-beta.101",
      "@effect/platform-bun": "4.0.0-beta.101",
      "@effect/openapi-generator": "4.0.0-beta.101",
      "@effect/vitest": "4.0.0-beta.101",
      "vitest": "4.1.10",
      "fast-check": "4.9.0",
      "@types/bun": "1.3.14",
      "typescript": "7.0.2",
      "@effect/tsgo": "0.24.3",
      "dependency-cruiser": "18.1.0",
      "@swc/core": "1.15.46",
      "oxlint": "1.75.0",
      "yaml": "2.9.0",
      "ssh2": "1.16.0",
      "@types/ssh2": "1.15.5"
    }
  },
  "scripts": {
    "typecheck": "for d in packages/* tools/*; do (cd \"$d\" && echo \"[typecheck] $d\" && ../../node_modules/.bin/tsc --noEmit) || exit 1; done",
    "test": "vitest run",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs packages tools",
    "codegen:check": "cd tools/codegen && bun run check",
    "ci": "bun run typecheck && bun run build:binary && bun run test && bun run lint:deps && bun run lint && bun run codegen:check",
    "lint": "oxlint",
    "build": "for d in core addons distro-k3s distro-ovh-mks dns-hetzner dns-ovh hetzner openstack provider-ovh secrets-sops storage-ovh volumes-cinder cli; do echo \"[build] $d\" && bun run --cwd \"packages/$d\" build || exit 1; done",
    "schema:generate": "bun scripts/generate-schema.ts",
    "version:bump": "node scripts/bump-version.mjs",
    "release:rewrite-deps": "node scripts/rewrite-workspace-deps.cjs",
    "build:binary": "bash scripts/build-binary.sh",
    "specs:update:ovh": "bash tools/ovh2openapi/scripts/update-specs.sh",
    "specs:update:openstack": "bash packages/openstack/scripts/update-specs.sh",
    "specs:update:hetzner": "bash packages/hetzner/scripts/update-specs.sh"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@kumulo/core": "workspace:*",
    "@kumulo/storage-ovh": "workspace:*",
    "@swc/core": "catalog:",
    "@types/bun": "catalog:",
    "dependency-cruiser": "catalog:",
    "effect": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
