[
  // kumulo: WHY required:true — see keystone.patch.json5. Spec omits `required`
  // on the requestBody, so the generator emits an optional payload union and
  // every create goes out with an empty body.
  {
    "op": "add",
    "path": "/paths/~1v2.1~1servers/post/requestBody/required",
    "value": true
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1os-server-groups/post/requestBody/required",
    "value": true
  },
  {
    "op": "replace",
    "path": "/components/schemas/ServersCreateRequest/oneOf",
    "value": [
      {
        "$ref": "#/components/schemas/ServersCreate_274"
      }
    ]
  },
  {
    "op": "remove",
    "path": "/components/schemas/ServersCreateResponse/oneOf/1"
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1servers~1{id}/get/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/servers_id"
      }
    ]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1servers~1{id}/delete/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/servers_id"
      }
    ]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1os-server-groups~1{id}/delete/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/os_server_groups_id"
      }
    ]
  }
  ,
  // kumulo: escape the `/` in these patterns. `RegExp` escapes an unescaped
  // slash outside a character class when it normalises `source`, and
  // effect's `isPattern` payload check requires the payload to already match
  // that normalised form — so the raw spec value fails to import with
  // "Invalid representation payload for effect/schema/isPattern". Escaping
  // here is equivalent to the regex the spec means. Slashes INSIDE a
  // character class (keystone's `^[^,/]*$`) need no escaping and are left
  // alone. Remove once effect accepts non-canonical payloads.
  {
    "op": "replace",
    "path": "/components/schemas/ServersCreate_274/properties/os:scheduler_hints/properties/cidr/pattern",
    "value": "^\\/[0-9a-f.:]+$"
  },
  {
    "op": "replace",
    "path": "/components/schemas/ServersCreate_274/properties/OS-SCH-HNT:scheduler_hints/properties/cidr/pattern",
    "value": "^\\/[0-9a-f.:]+$"
  }
]
