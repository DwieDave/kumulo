[
  // kumulo: WHY required:true — see keystone.patch.json5. Spec omits `required`
  // on the requestBody, so the generator emits an optional payload union and
  // every create goes out with an empty body.
  {
    "op": "add",
    "path": "/paths/~1v2.1~1servers/post/requestBody/required",
    "value": true
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1os-server-groups/post/requestBody/required",
    "value": true
  },
  {
    "op": "replace",
    "path": "/components/schemas/ServersCreateRequest/oneOf",
    "value": [
      {
        "$ref": "#/components/schemas/ServersCreate_274"
      }
    ]
  },
  {
    "op": "remove",
    "path": "/components/schemas/ServersCreateResponse/oneOf/1"
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1servers~1{id}/get/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/servers_id"
      }
    ]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1servers~1{id}/delete/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/servers_id"
      }
    ]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.1~1os-server-groups~1{id}/delete/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/os_server_groups_id"
      }
    ]
  }
]
