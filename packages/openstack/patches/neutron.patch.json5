[
  // kumulo: WHY required:true — see keystone.patch.json5. Spec omits `required`
  // on the requestBody, so the generator emits an optional payload union and
  // every create goes out with an empty body.
  {
    "op": "add",
    "path": "/paths/~1v2.0~1security-groups/post/requestBody/required",
    "value": true
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1security-group-rules/post/requestBody/required",
    "value": true
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1networks/post/requestBody/required",
    "value": true
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1subnets/post/requestBody/required",
    "value": true
  },
  {
    "op": "remove",
    "path": "/paths/~1v2.0~1security-groups/get/parameters/0"
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1security-groups~1{id}/delete/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/security_groups_id"
      }
    ]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1networks~1{network_id}/delete/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/networks_network_id"
      }
    ]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1floatingips/post/requestBody/required",
    "value": true
  },
  // The collection GET lists `floatingips_id` — an `in: path` parameter — as its
  // first filter. Same upstream defect as security-groups' GET, same removal.
  {
    "op": "remove",
    "path": "/paths/~1v2.0~1floatingips/get/parameters/0"
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1floatingips~1{id}/delete/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/floatingips_id"
      }
    ]
  },
  // The PUT is what re-associates an adopted floating IP with a recreated load
  // balancer's VIP port — Neutron nulls `port_id` when the old port goes away.
  {
    "op": "add",
    "path": "/paths/~1v2.0~1floatingips~1{id}/put/requestBody/required",
    "value": true
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1floatingips~1{id}/put/parameters",
    "value": [
      {
        "$ref": "#/components/parameters/floatingips_id"
      }
    ]
  },
  // kumulo: `/v2.0/routers` GET declares `routers_id` as a PATH parameter on a
  // collection endpoint that has no `{id}` in its path, so the generator emits a
  // required `RoutersGetPathParams = { id: string }` that no caller can satisfy
  // — every list call fails to decode. Same shape as the security-groups GET
  // patch above.
  {
    "op": "remove",
    "path": "/paths/~1v2.0~1routers/get/parameters/0"
  },
  // Same missing `required` as the networks/subnets creates above.
  {
    "op": "add",
    "path": "/paths/~1v2.0~1routers/post/requestBody/required",
    "value": true
  }
  ,
  // kumulo: these three declare no `parameters` at all, so `{id}` is never
  // substituted and the client sends the literal `:id` in the path. Same fix as
  // the networks/security-groups deletes above.
  {
    "op": "add",
    "path": "/paths/~1v2.0~1routers~1{id}~1add_router_interface/put/parameters",
    "value": [{ "$ref": "#/components/parameters/routers_id" }]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1routers~1{id}~1remove_router_interface/put/parameters",
    "value": [{ "$ref": "#/components/parameters/routers_id" }]
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1routers~1{id}/delete/parameters",
    "value": [{ "$ref": "#/components/parameters/routers_id" }]
  }
  ,
  // Same missing `required` again: without it the payload is a NoContent union
  // and the interface PUTs go out with an empty body.
  {
    "op": "add",
    "path": "/paths/~1v2.0~1routers~1{id}~1add_router_interface/put/requestBody/required",
    "value": true
  },
  {
    "op": "add",
    "path": "/paths/~1v2.0~1routers~1{id}~1remove_router_interface/put/requestBody/required",
    "value": true
  }
  ,
  // kumulo: the Neutron spec mistypes this response repeatedly — OVH sends
  // `ipv4_address_scope`/`ipv6_address_scope` as null and `l2_adjacency` as a
  // boolean, both typed `string` here, and each one killed a real apply AFTER
  // the network was created. kumulo reads only `id` and `name` off these, so
  // every other scalar is widened to tolerate null (and l2_adjacency a bool)
  // rather than waiting to be broken by the next field nobody reads.
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/created_at/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/description/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/dns_domain/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/ipv4_address_scope/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/ipv6_address_scope/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/l2_adjacency/type",
    "value": ["string", "boolean", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/mtu/type",
    "value": ["integer", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/provider:network_type/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/provider:physical_network/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/revision_number/type",
    "value": ["integer", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/status/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/tenant_id/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksIndexResponse/properties/networks/items/properties/updated_at/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/created_at/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/description/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/dns_domain/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/ipv4_address_scope/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/ipv6_address_scope/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/l2_adjacency/type",
    "value": ["string", "boolean", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/mtu/type",
    "value": ["integer", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/provider:network_type/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/provider:physical_network/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/revision_number/type",
    "value": ["integer", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/status/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/tenant_id/type",
    "value": ["string", "null"]
  },
  {
    "op": "replace",
    "path": "/components/schemas/NetworksCreateResponse/properties/network/properties/updated_at/type",
    "value": ["string", "null"]
  }
  ,
  // kumulo: UPSTREAM CODEGEN BUG, worked around here.
  // `@effect/openapi-generator` drops "null" from a `type: [..., "null"]`
  // union whenever the property also carries a `format`, emitting a
  // one-member `Schema.Union([Schema.String.annotate(...)])`. Such a field
  // then rejects the null the spec itself documents — `qos_policy_id` killed
  // a real apply, and floatingips carry the same shape on a path kumulo uses.
  // `format` is a pure annotation here (Effect Schema does not validate on
  // it), so dropping it costs nothing and restores the union.
  // Scoped to schemas the allowlist actually emits — the pipeline prunes
  // before patching, so an op against a pruned schema is a hard error.
  // Revert once the generator honours null alongside format.
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsCreateRequest/properties/floatingip/properties/subnet_id/format"
  },
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsCreateRequest/properties/floatingip/properties/port_id/format"
  },
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsCreateRequest/properties/floatingip/properties/qos_policy_id/format"
  },
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsCreateResponse/properties/floatingip/properties/router_id/format"
  },
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsCreateResponse/properties/floatingip/properties/port_id/format"
  },
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsCreateResponse/properties/floatingip/properties/qos_policy_id/format"
  },
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsIndexResponse/properties/floatingips/items/properties/router_id/format"
  },
  {
    "op": "remove",
    "path": "/components/schemas/FloatingipsIndexResponse/properties/floatingips/items/properties/port_id/format"
  },
