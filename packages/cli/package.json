{
  "name": "@kumulo/cli",
  "version": "0.1.1",
  "description": "kumulo CLI \u2014 declarative Kubernetes cluster provisioning on OVH/Hetzner.",
  "license": "MIT",
  "author": "David Stahl-Gruber",
  "homepage": "https://github.com/DwieDave/kumulo#readme",
  "bugs": "https://github.com/DwieDave/kumulo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DwieDave/kumulo.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "cli",
    "kubernetes",
    "provisioning",
    "effect",
    "typescript"
  ],
  "type": "module",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "kumulo": "./dist/main.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "dependencies": {
    "@kumulo/addons": "workspace:*",
    "@kumulo/core": "workspace:*",
    "@kumulo/distro-k3s": "workspace:*",
    "@kumulo/distro-ovh-mks": "workspace:*",
    "@kumulo/dns-hetzner": "workspace:*",
    "@kumulo/dns-ovh": "workspace:*",
    "@kumulo/hetzner": "workspace:*",
    "@kumulo/openstack": "workspace:*",
    "@kumulo/provider-ovh": "workspace:*",
    "@kumulo/secrets-sops": "workspace:*",
    "@kumulo/storage-ovh": "workspace:*",
    "@kumulo/volumes-cinder": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "@effect/platform-node": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "vitest": "catalog:",
    "effect": "catalog:",
    "@effect/platform-node": "catalog:"
  },
  "scripts": {
    "build": "bash ../../scripts/build-package.sh src/main.ts",
    "prepack": "node ../../scripts/prepack-exports.mjs strip",
    "postpack": "node ../../scripts/prepack-exports.mjs restore",
    "prepublishOnly": "bun run build"
  }
}
