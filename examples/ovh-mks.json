{
  "$schema": "../kumulo.schema.json",
  "name": "staging-eu",
  "provider": "ovh",
  "distro": "ovh-mks",
  "version": "1.35.0",
  "auth": {
    "method": "application_credential",
    "region": "DE1"
  },
  "network": {
    "cidr": "10.0.0.0/16",
    "nodes_subnet": "10.0.1.0/24",
    "load_balancers_subnet": "10.0.2.0/24"
  },
  "ingress": {},
  "worker_pools": [
    {
      "name": "general",
      "flavor": "d2-4",
      "count": 1,
      "labels": {
        "workload": "general"
      },
      "autoscaling": {
        "enabled": true,
        "min": 1,
        "max": 1
      }
    }
  ],
  "dns": {
    "module": "none"
  },
  "volumes": {
    "module": "cinder",
    "managed": [
      {
        "name": "staging-eu-data",
        "size_gb": 10,
        "type": "classic",
        "retain": false,
        "pvc": {
          "namespace": "default",
          "access_modes": ["ReadWriteOnce"]
        }
      }
    ]
  },
  "object_storage": {
    "module": "ovh",
    "buckets": [
      {
        "name": "staging-eu-backups",
        "region": "DE",
        "versioning": false,
        "encryption": false,
        "retain": false
      },
      {
        "name": "staging-eu-logs",
        "region": "DE",
        "versioning": true,
        "encryption": false,
        "retain": false
      }
    ]
  },
  "secrets": {
    "sink": "sops",
    "dir": ".",
    "sops": {
      "age_recipient": "age1xv0gzkxnvr08jtqyfjmcqd0qrfxlg4vu0gwnjradd4dy6ufh5v0sgd6c3t"
    }
  }
}
