{
  "$schema": "../kumulo.schema.json",
  "name": "staging-de",
  "provider": "upcloud",
  "distro": "upcloud-uks",
  "version": "1.35",
  "auth": {
    "method": "api_token",
    "region": "de-fra1"
  },
  "zone": "de-fra1",
  "plan": "dev-md",
  "network": {
    "cidr": "10.0.0.0/16"
  },
  "worker_pools": [
    {
      "name": "general",
      "flavor": "CLOUDNATIVE-1xCPU-8GB",
      "count": 1,
      "labels": {
        "workload": "general"
      }
    }
  ],
  "dns": {
    "module": "none"
  },
  "volumes": {
    "module": "upcloud",
    "managed": [
      {
        "name": "staging-de-data",
        "size_gb": 10,
        "type": "standard",
        "retain": false,
        "pvc": {
          "namespace": "default",
          "access_modes": [
            "ReadWriteOnce"
          ]
        }
      }
    ]
  },
  "object_storage": {
    "module": "upcloud",
    "region": "europe-1",
    "buckets": [
      {
        "name": "staging-de-backups",
        "retain": false
      }
    ]
  },
  "secrets": {
    "sink": "sops",
    "dir": ".",
    "sops": {
      "age_recipient": "age1xv0gzkxnvr08jtqyfjmcqd0qrfxlg4vu0gwnjradd4dy6ufh5v0sgd6c3t"
    }
  }
}
